# ==============================================================================
# SHOONYA (FINVASIA) API CONFIGURATION
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file with secrets to git!
# ==============================================================================

# 1. Your 6-character Shoonya/Finvasia Client ID (e.g., FA12345)
SHOONYA_USER_ID=FA12345

# 2. Your Shoonya login password
SHOONYA_PASSWORD=YourShoonyaPasswordHere

# 3. Your Base32 TOTP Secret Key (from Shoonya 2FA setup in Google Authenticator)
# E.g. JBSWY3DPEHPK3PXP
SHOONYA_TOTP_KEY=JBSWY3DPEHPK3PXP

# 4. Your Finvasia Vendor Code (usually your USER_ID + _U, e.g. FA12345_U)
SHOONYA_VENDOR_CODE=FA12345_U

# 5. Your API Key generated in the Shoonya Prism portal
SHOONYA_API_KEY=your_generated_api_key_here

# 6. Shoonya OAuth 2.0 Credentials (from Prism "Get API Key")
SHOONYA_CLIENT_ID=your_oauth_client_id_here
SHOONYA_SECRET_CODE=your_oauth_secret_code_here
SHOONYA_ACCESS_TOKEN=
