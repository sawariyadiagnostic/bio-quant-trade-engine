*.pickle
*.weights
*.pt
*.pth
*.onnx
data/cache/
data/raw/

# IDE & OS Metadata
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Scratch & Temporary Testing Files
scratch/
tmp/
temp/
